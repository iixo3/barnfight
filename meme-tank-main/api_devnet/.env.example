# Barnfight API (devnet). Copy to .env and fill in.
# Also needs firebaseServiceAccount.json (Firebase service-account key) in this folder; it is never committed.
SOLANA_RPC_URL=       # RPC endpoints
SOLANA_RPC_URL_2=
SOLANA_RPC_URL_3=
PORT=
PROGRAM_ID=           # deployed memetank program address
MASTER_PDA=           # master account address
MASTER_ADMIN_FEES=    # wallet that receives the fees
MASTER_ADMIN_SWAP=    # wallet that swaps the prize tokens
KEYPAIR_ADMIN_SWAP=   # secret key of the swap wallet, as a JSON array of numbers
