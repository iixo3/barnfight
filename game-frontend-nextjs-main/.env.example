# Game front end (Next.js). Copy to .env.local and fill in.

# Firebase
FIREBASE_ADMIN_PRIVATE_KEY=          # Firebase service-account JSON, on one line
FIREBASE_PROJECT_ID=                 # Firebase project used on mainnet
FIREBASE_PROJECT_ID_DEV=             # Firebase project used on devnet
NEXT_PUBLIC_FIREBASE_CLIENT_CONFIG=  # Firebase web-app config, as JSON

# Solana
NEXT_PUBLIC_CLUSTER_MEMETANK_PROGRAM=  # devnet or mainnet
NEXT_PUBLIC_SOLANA_RPC_URL_MAINNET=    # mainnet RPC endpoint
NEXT_PUBLIC_SOLANA_RPC_URLS=           # comma-separated mainnet RPC endpoints, one picked at random
NEXT_PUBLIC_ADMIN_WALLET_FEES=         # wallet that receives the fees
WHITELISTED_WALLETS=                   # comma-separated wallets allowed to create games

# Search (Algolia)
NEXT_PUBLIC_ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_API_KEY=
NEXT_PUBLIC_ALGOLIA_INDEX=

# Streams
TWITCH_CLIENT_ID=
TWITCH_SECRET=
YOUTUBE_API_KEY=
TWITCH_DEMO_GAME_ID=   # game shown on the /twitch demo page

# Price chart database (Postgres connection string)
CHART_DB=


NEXT_PUBLIC_TIMEOUT=
